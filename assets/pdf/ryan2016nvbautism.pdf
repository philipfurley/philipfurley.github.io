         <dc:subject>
            <rdf:Bag>
               <rdf:li>Sport; Emotion expression; Nonverbal behavior; Thin slices; Autism; Social rank</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Judgments of Nonverbal Behaviour by Children with High-Functioning Autism Spectrum Disorder: Can they Detect Signs of Winning and Losing from Brief Video Clips?</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Christian Ryan</rdf:li>
               <rdf:li>Philip Furley</rdf:li>
               <rdf:li>Kathleen Mulhall</rdf:li>
            </rdf:Seq>
         </dc:creator>
